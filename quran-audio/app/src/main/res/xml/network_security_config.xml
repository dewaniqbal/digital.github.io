<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. No cleartext, no user-installed CAs, no trust-all. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Certificate pinning is added per flavor once the backend host + backup pins are known. -->
</network-security-config>
